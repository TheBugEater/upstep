# Database (Neon, Supabase, or any Postgres)
DATABASE_URL="postgresql://user:password@host:5432/upstep?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/upstep?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Protects the notification retry endpoint. Use a long random value in production.
CRON_SECRET=""

# OAuth providers (configure at least one to sign in)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email notifications (SendPanda — https://api.sendpanda.email/docs)
# Use a send-only key. Keep the real key in .env, never in this template.
SENDPANDA_API_KEY=""
# Replace this placeholder with a sender on a domain verified in SendPanda.
SENDPANDA_FROM_EMAIL="UpStep Team <hello@your-verified-domain.example>"
# Published templates (optional; blank uses the source copies in email-templates.ts)
SENDPANDA_FEEDBACK_TEMPLATE_ID=""
SENDPANDA_INVITATION_TEMPLATE_ID=""
SENDPANDA_TEST_TEMPLATE_ID=""

# Stripe billing
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Signing secret for the webhook endpoint (stripe listen / dashboard)
STRIPE_WEBHOOK_SECRET=""
# Recurring price IDs for each paid plan (Products → Pricing)
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Optional OnRamp product analytics (disabled when blank)
NEXT_PUBLIC_ONRAMP_API_KEY=""

# Upstep — dogfood: collect feedback on Upstep itself
# Create a project at /dashboard, copy its API key here.
# NEXT_PUBLIC_UPSTEP_BASE_URL should match AUTH_URL in production (e.g. https://upstep.dev)
NEXT_PUBLIC_UPSTEP_API_KEY=""
NEXT_PUBLIC_UPSTEP_BASE_URL="http://localhost:3000"
