{
  "name": "@upstep/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "type-check": "tsc --noEmit",
    "build": "expo export --platform ios --platform android",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
